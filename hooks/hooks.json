{
  "description": "Hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/bin/turnecho\" hook prompt || printf '{}\\n'",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/bin/turnecho\" hook stop || printf '{}\\n'",
            "statusMessage": "Talking back to you",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
