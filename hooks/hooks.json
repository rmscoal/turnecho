{
  "description": "Hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/run_hook.sh\" prompt || printf '{}\\n'",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/run_hook.sh\" stop || printf '{}\\n'",
            "statusMessage": "Talking back to you",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
