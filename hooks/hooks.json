{
  "description": "Hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$PLUGIN_ROOT/src\" uv run --project \"$PLUGIN_ROOT\" --no-dev --no-sync python -m turnecho.prompt_hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$PLUGIN_ROOT/src\" uv run --project \"$PLUGIN_ROOT\" --no-dev --no-sync python -m turnecho.stop_hook",
            "statusMessage": "Talking back to you",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
